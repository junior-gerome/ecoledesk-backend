# Connexion a la base de donnees MySQL : URL, utilisateur, mot de passe et pilote JDBC.
DB_URL:jdbc:mysql://localhost:3306/bd_gsbp?createDatabaseIfNotExist=true&serverTimezone=UTC&useSSL=false
DB_USERNAME:root
DB_PASSWORD:


# Hibernate/JPA : valide le schema existant par defaut, sans le creer ni le modifier.
JPA_DDL_AUTO:validate
# Affiche les requetes SQL generees seulement si JPA_SHOW_SQL vaut true.
JPA_SHOW_SQL:true


# Flyway : execute et gere les migrations versionnees de la base de donnees.
FLYWAY_ENABLED:true


# JWT : cle de signature et duree de validite des jetons d'acces et de rafraichissement, en millisecondes.
JWT_SECRET:dev-only-local-jwt-secret-change-me-32chars-minimum
JWT_EXPIRATION:86400000
JWT_REFRESH_EXPIRATION:604800000

# Creation facultative d'un administrateur initial au demarrage de l'application.
APP_BOOTSTRAP_ADMIN_ENABLED:true
APP_BOOTSTRAP_ADMIN_EMAIL:admin@admin.local
APP_BOOTSTRAP_ADMIN_PASSWORD:aDmin@123

# CORS : origines, methodes et en-tetes autorises pour les appels effectues depuis le navigateur.
APP_CORS_ALLOWED_ORIGINS:http://localhost:4200,http://127.0.0.1:4200


# Cache et Redis : type de cache par defaut, adresse, port et delai d'attente du serveur Redis.
SPRING_CACHE_TYPE:simple
REDIS_HOST:localhost
REDIS_PORT:6379
REDIS_TIMEOUT:2s

# Actuator et Prometheus : endpoints exposes, niveau de detail de sante et metriques publiees.
MANAGEMENT_HEALTH_SHOW_DETAILS:never

# Niveaux de journalisation : application, SQL Hibernate, securite et couche Web.
APP_LOG_LEVEL:INFO
HIBERNATE_SQL_LOG_LEVEL:WARN
HIBERNATE_BINDER_LOG_LEVEL:WARN
SPRING_SECURITY_LOG_LEVEL:INFO
lAPP_SECURITY_LOG_LEVEL:INFO
SPRING_WEB_LOG_LEVEL:INFO
HIBERNATE_TYPE_LOG_LEVEL:WARN
# Niveau de journalisation specifique au moteur de validation Hibernate Validator.
HIBERNATE_VALIDATOR_LOG_LEVEL:INFO

# Active le pare-feu HTTP strict de Spring Security.
SPRING_SECURITY_FIREWALL_STRICT:true

# Televersement de fichiers : dossier de stockage et limites de taille.
FILE_UPLOAD_DIR:uploads